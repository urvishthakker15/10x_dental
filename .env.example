# Copy to .env and replace values before using --send.
RESEND_API_KEY=replace_with_your_resend_api_key
# Use onboarding@resend.dev only for the limited Resend test flow. For regular
# sending, use an address on a domain verified in Resend.
EMAIL_FROM=Recall Outreach <onboarding@resend.dev>
RECALL_TIME_ZONE=America/Los_Angeles
